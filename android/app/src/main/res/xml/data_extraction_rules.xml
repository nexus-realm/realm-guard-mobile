<?xml version="1.0" encoding="utf-8"?>
<!--
  Security-first: Realm Guard is an offline-first vault with no account and no
  data worth backing up. Exclude all app data from both cloud backup and
  device-to-device transfer (Android 12+/API 31+) so the encrypted vault, the
  salt and the secured storage never leave the device automatically.
  Combined with android:allowBackup="false" (covers API <= 30).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
